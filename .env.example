# Settings for the n8n container that runs this project.
# Copy to .env and adjust. .env is git-ignored.
#
# The Anthropic API key does NOT go here. Store it as an n8n credential
# (Header Auth, name "x-api-key"); see docs/SETUP.md.

# Keep this project on its own port so it never collides with other n8n instances
N8N_PORT_ON_HOST=5679

# Timezone used by schedule/poll triggers and timestamps in the UI
GENERIC_TIMEZONE=Europe/Berlin
TZ=Europe/Berlin

# Encrypts stored credentials. Generate a long random string once and keep it:
# losing it makes existing credentials unreadable.
N8N_ENCRYPTION_KEY=replace-with-a-long-random-string

# Public base URL, used for webhook URLs and the Google OAuth callback
WEBHOOK_URL=http://localhost:5679/

N8N_DIAGNOSTICS_ENABLED=false
